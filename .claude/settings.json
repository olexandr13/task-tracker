{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/deployFirestoreRules.js\" --hook",
            "timeout": 180,
            "statusMessage": "Checking firestore.rules"
          }
        ]
      }
    ]
  }
}
