# Copy to .env.local (ignored by git) and fill in. The values are printed by:
#   npx -y firebase-tools@latest apps:sdkconfig WEB --project task-tracker-a6e9e
# Production builds read the same names from the Vercel project's environment variables.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
