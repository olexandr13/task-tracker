rules_version = '2';

// Everything sits under the account's own id, and only the account itself reads
// or writes it — with one exception: a list its owner shares (LST-27). Anything
// else in the database is denied.
//
// - Shares: one document per shared list, at shares/{listId}, stored as
//   { version, share: { listId, ownerId, ownerEmail, ownerName, members } }
//   (src/storage/shareSchema.ts) — members being email addresses, lowercase.
//   Its owner writes it, for one of their own lists; they and its members read
//   it; a member may only take themselves off it. While it names someone, they
//   read that list and read and write the tasks filed under it, which stay in
//   the owner's account (STORE-66, STORE-67).
//
// - Tasks: one document per task, stored as { version, task }
//   (src/storage/firestoreTaskRepository.ts), always filed under the task's id.
// - Lists: one document per list, stored as { version, list }
//   (src/storage/firestoreListRepository.ts), always filed under the list's id.
// - Goals: one document per goal, stored as { version, goal }
//   (src/storage/firestoreGoalRepository.ts), always filed under the goal's id.
// - Tags: one document per kept tag, stored as { version, tag }
//   (src/storage/firestoreTagRepository.ts), always filed under the tag's id.
// - Points earned: one document per day, stored as { version, day, entries }
//   (src/storage/firestoreRewardRepository.ts), always filed under its day.
// - Points redeemed: one document per redemption, stored as { version, redemption },
//   always filed under the redemption's id.
// - Prizes: one document per prize on the wishlist, stored as { version, prize }
//   (src/storage/firestorePrizeRepository.ts), always filed under the prize's id.
// - Points for clearing a period: one document per period, stored as
//   { version, goal }, always filed under the period the goal names.
// - Settings of the points: one document per setting, stored as
//   { version, name, value } — what a point is worth is the only one so far —
//   always filed under the name it carries.
// - The warm-up: the one document it is ever kept as, stored as
//   { version, name, warmUp } (src/storage/firestoreWarmUpRepository.ts),
//   filed under that name, and no document at all is no warm-up.
// - Procrastination mode: the one document it is ever kept as, stored as
//   { version, name, state } (src/storage/firestoreProcrastinationRepository.ts),
//   filed under that name, and no document at all is the mode off.
// - The nudge's setting: the one document it is ever kept as, stored as
//   { version, name, nudge } (src/storage/firestoreNudgeRepository.ts), filed
//   under that name, and no document at all is the nudge off at its defaults.
// - Balance categories: one document per category, stored as { version, category }
//   (src/storage/firestoreCategoryRepository.ts), always filed under the category's id.
// - The activity log: one document per day, stored as { version, day, entries }
//   (src/storage/firestoreActivityRepository.ts), always filed under its day.
// - The check-in's setting: the one document it is ever kept as, stored as
//   { version, name, checkIn } (src/storage/firestoreCheckInRepository.ts), filed
//   under that name, and no document at all is the check-in off at its defaults.
// - The switches on Settings: the one document they are ever kept as, stored as
//   { version, name, off } (src/storage/firestoreFeatureRepository.ts), filed
//   under that name, and no document at all is every feature on.
// - The journal: one document per day, stored as { version, day, entries }
//   (src/storage/firestoreJournalRepository.ts), always filed under its day.
// - Notes: one document per note, stored as { version, note }
//   (src/storage/firestoreNoteRepository.ts), always filed under the note's id.
// - The habits' settings: one document per setting, stored as { version, name, ... }
//   (src/storage/firestoreHabitSettingsRepository.ts) — the limit on rests, { since },
//   is the only one so far — always filed under the name it carries, and no
//   document at all is the setting off.
// - Where XP stands: one document, stored as { version, name, xp, startedOn,
//   settledThrough, addsOn, adds } (src/storage/firestoreXpRepository.ts), filed
//   under the name it carries, and no document at all is XP not begun yet.
// - XP as an older version kept it, a ledger a day at a time: read once to move
//   it into where XP stands, then deleted. Nothing writes to it any more.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    // The address the signed-in account was proved to have, as shares keep it.
    function myEmail() {
      return request.auth.token.email.lower();
    }

    function hasProvedEmail() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    // Whether a share (its stored `share` map) names the signed-in account.
    function isMemberOf(share) {
      return hasProvedEmail() && myEmail() in share.members;
    }

    // Whether the account's list `listId` is shared with the signed-in account.
    function isSharedWithMe(accountId, listId) {
      let share = get(/databases/$(database)/documents/shares/$(listId)).data.share;
      return share.ownerId == accountId && isMemberOf(share);
    }

    // Whether a stored task is filed under a list of the account's shared with the signed-in account.
    function isInListSharedWithMe(accountId, stored) {
      return stored.task.listId is string && isSharedWithMe(accountId, stored.task.listId);
    }

    match /users/{accountId}/tasks/{taskId} {
      allow read, delete: if isOwner(accountId) || isInListSharedWithMe(accountId, resource.data);
      allow create: if request.resource.data.task.id == taskId
        && (isOwner(accountId) || isInListSharedWithMe(accountId, request.resource.data));
      // Someone a list is shared with changes its tasks, and moves them between
      // the owner's lists shared with them, but never files one anywhere else.
      allow update: if request.resource.data.task.id == taskId
        && (isOwner(accountId)
          || (isInListSharedWithMe(accountId, resource.data)
            && isInListSharedWithMe(accountId, request.resource.data)));
    }

    match /users/{accountId}/lists/{listId} {
      allow read: if isOwner(accountId) || isSharedWithMe(accountId, listId);
      allow delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.list.id == listId;
    }

    match /shares/{listId} {
      // The owner's own shares, and those naming the signed-in account: each
      // asked for on its own (share.ownerId ==, share.members array-contains).
      allow read: if request.auth != null
        && (resource.data.share.ownerId == request.auth.uid || isMemberOf(resource.data.share));

      // Written whole by the owner, for a list of their own, never naming them.
      allow create: if isWrittenByOwner(listId);
      allow update: if (resource.data.share.ownerId == request.auth.uid && isWrittenByOwner(listId))
        || leavesOnly();
      // Deleting one that is not there deletes nothing: the owner's app deletes
      // the share with the list, whether or not it knew the list was shared.
      allow delete: if request.auth != null
        && (resource == null || resource.data.share.ownerId == request.auth.uid);

      function isWrittenByOwner(listId) {
        let share = request.resource.data.share;
        return request.auth != null
          && share.ownerId == request.auth.uid
          && share.listId == listId
          && share.members is list
          && share.members.size() <= 50
          && !(myEmail() in share.members)
          && existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)/lists/$(listId));
      }

      // Someone a list is shared with takes themselves off it, and nothing else.
      function leavesOnly() {
        let before = resource.data.share;
        let after = request.resource.data.share;
        return isMemberOf(before)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['share'])
          && after.diff(before).affectedKeys().hasOnly(['members'])
          && after.members == before.members.removeAll([myEmail()]);
      }
    }

    match /users/{accountId}/goals/{goalId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.goal.id == goalId;
    }

    match /users/{accountId}/tags/{tagId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.tag.id == tagId;
    }

    match /users/{accountId}/prizes/{prizeId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.prize.id == prizeId;
    }

    match /users/{accountId}/rewardDays/{day} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.day == day;
    }

    match /users/{accountId}/redemptions/{redemptionId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.redemption.id == redemptionId;
    }

    match /users/{accountId}/rewardGoals/{period} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.goal.period == period;
    }

    match /users/{accountId}/rewardSettings/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/warmUp/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/procrastination/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/nudge/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/categories/{categoryId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.category.id == categoryId;
    }

    match /users/{accountId}/activityDays/{day} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.day == day;
    }

    match /users/{accountId}/checkIn/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/features/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/journalDays/{day} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.day == day;
    }

    match /users/{accountId}/notes/{noteId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.note.id == noteId;
    }

    match /users/{accountId}/habitSettings/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }

    match /users/{accountId}/xpDays/{day} {
      allow read, delete: if isOwner(accountId);
    }

    match /users/{accountId}/levelSettings/{name} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.name == name;
    }
  }
}
