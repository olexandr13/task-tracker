rules_version = '2';

// Nothing reads or writes Firestore yet: tasks are still kept in the browser
// (wiki/account.md, AUTH-13). Everything is denied until the tasks data model
// lands, and its rules are written against that model.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
