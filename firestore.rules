rules_version = '2';

// Everything sits under the account's own id, and only the account itself reads
// or writes it. Anything else in the database is denied.
//
// - Tasks: one document per task, stored as { version, task }
//   (src/storage/firestoreTaskRepository.ts), always filed under the task's id.
// - Lists: one document per list, stored as { version, list }
//   (src/storage/firestoreListRepository.ts), always filed under the list's id.
// - Tags: one document per kept tag, stored as { version, tag }
//   (src/storage/firestoreTagRepository.ts), always filed under the tag's id.
// - Points earned: one document per day, stored as { version, day, entries }
//   (src/storage/firestoreRewardRepository.ts), always filed under its day.
// - Points redeemed: one document per redemption, stored as { version, redemption },
//   always filed under the redemption's id.
// - Points for clearing a period: one document per period, stored as
//   { version, goal }, always filed under the period the goal names.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(accountId) {
      return request.auth != null && request.auth.uid == accountId;
    }

    match /users/{accountId}/tasks/{taskId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.task.id == taskId;
    }

    match /users/{accountId}/lists/{listId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.list.id == listId;
    }

    match /users/{accountId}/tags/{tagId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.tag.id == tagId;
    }

    match /users/{accountId}/rewardDays/{day} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.day == day;
    }

    match /users/{accountId}/redemptions/{redemptionId} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.redemption.id == redemptionId;
    }

    match /users/{accountId}/rewardGoals/{period} {
      allow read, delete: if isOwner(accountId);
      allow create, update: if isOwner(accountId) && request.resource.data.goal.period == period;
    }
  }
}
