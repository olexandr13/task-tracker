{
  "name": "pickme-functions",
  "private": true,
  "description": "The hourly check-in sender (CHECKIN-10): a scheduled Firebase function, and the test it sends on request.",
  "type": "module",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc --noEmit -p . && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=lib/index.js --external:firebase-admin --external:firebase-functions --external:web-push"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.2"
  }
}
